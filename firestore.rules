rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Recipes, shopping list, meal plan — each user only ever touches their own path.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily usage counters — written only by the Cloud Function (via the Admin SDK,
    // which bypasses these rules entirely), never directly by client apps.
    match /usage/{docId} {
      allow read, write: if false;
    }
  }
}
